# cp .env.example .env  후 실제 값으로 채우기 (.env는 git에 안 올라감)
# 이건 superuser(postgres) 비번. 앱별 role 비번은 initdb/01-init.sql 참고.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=postgres

# 앱별 role 비번 (initdb/01-init.sh가 읽어 role 생성). 작은따옴표(') 금지.
VAULT_RAG_DB_PASSWORD=change_me_vault_rag
AIRFLOW_DB_PASSWORD=change_me_airflow

# grafana.rimsm.com으로 공개 터널 노출되므로 반드시 강한 비번으로 교체할 것. USER는 미설정 시 admin.
GRAFANA_ADMIN_USER=change_me_grafana_user
GRAFANA_ADMIN_PASSWORD=change_me_grafana
